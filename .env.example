# ============================================================
# Config do laboratório ADINT. Copie para ".env" e preencha.
# O .env real está no .gitignore — NUNCA comite suas chaves.
# ============================================================

# --- Docker / Elastic Stack ---
STACK_VERSION=8.15.3
ES_HOST=localhost
ES_PORT=9200

# --- Shodan (módulo SHODAN) — chave em https://account.shodan.io ---
SHODAN_API_KEY=

# --- Telegram (coleta de vazamentos, opcional) — my.telegram.org ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# ID numérico do canal (formato -100XXXXXXXXXX). Descubra o seu com TELEGRAM/nome_grupos.py
TELEGRAM_CHANNEL_ID=
TELEGRAM_INDEX=vazamentos_dados

# --- Robtex via RapidAPI (host robtex.p.rapidapi.com) — ASSINE a API no RapidAPI antes de usar ---
ROBTEX_RAPIDAPI_KEY=

# --- Fontes do SUBFINDER ---
# ATENCAO: o subfinder NAO le estas chaves do .env — elas vao no arquivo proprio dele,
# ~/.config/subfinder/provider-config.yaml. Mantidas aqui so como lembrete do que voce tem.
GITHUB_TOKEN=
SECURITYTRAILS_API_KEY=
